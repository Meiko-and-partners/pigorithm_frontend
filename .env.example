# Pigorithm frontend configuration. Copy to .env.local for local development.
#
# NEXT_PUBLIC_API_URL is the backend's versioned API root (NestJS global prefix
# /api/v1). It is inlined into the browser bundle at build time, so it must be
# public: never put secrets in NEXT_PUBLIC_ variables.
#
# Local backend (pigorithm_backend, PORT defaults to 3000):
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
#
# Deployed backend (set in the frontend host's environment before building):
# NEXT_PUBLIC_API_URL=https://pigorithm.onrender.com/api/v1
